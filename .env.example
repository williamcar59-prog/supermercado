# Copie este arquivo para `.env` (fica só na sua máquina, nunca vai ao Git)
# e preencha com os dados do SEU projeto Supabase:
#   supabase.com → seu projeto → Project Settings → API
#
# A anon key é PÚBLICA por design (vai no bundle do navegador).
# A segurança de verdade está na RLS (supabase/schema.sql).
#
# Sem estas variáveis o app funciona 100% local (compartilhamento desligado).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
